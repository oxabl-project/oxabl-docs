---
import Logo from "./Logo.astro";
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import { Button } from "./ui/button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { config } from "virtual:nimbus/config";
import { getCollectionUrl, getSidebarSections, stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const { collection, showSidebar = true, sections: sectionsProp } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const sidebarSections =
  sectionsProp ?? (await getSidebarSections(currentSlug, { collection }));
// An API reference beside the docs isn't in the docs sidebar, so the docs and
// each reference become the tabs. A reference served at the root is the site.
const apiHrefs = (
  await Promise.all((config.api ?? []).map(async (entry) => ({ entry, href: await getCollectionUrl(entry.collection) })))
).filter(({ href }) => href !== "/");
// The reference the page is in: the longest mount that is the path or a folder of it.
const mountOf = (href: string) => href.replace(/\/$/, "");
const activeApi = apiHrefs
  .filter(({ href }) => currentSlug === mountOf(href) || currentSlug.startsWith(`${mountOf(href)}/`))
  .sort((a, b) => b.href.length - a.href.length)[0];
const sections =
  sidebarSections.length >= 2 || sectionsProp || apiHrefs.length === 0
    ? sidebarSections
    : [
        // A page outside every collection (the 404) is in neither tab.
        { label: "Docs", href: "/", isActive: activeApi === undefined && collection !== undefined },
        ...apiHrefs.map((api) => ({
          label: apiHrefs.length === 1 ? "API reference" : (api.entry.label ?? api.entry.collection),
          href: api.href,
          isActive: api === activeApi,
        })),
      ];
const showSections = sections.length >= 2;
const resolveSectionHref = (href: string): string =>
  withBase(href, import.meta.env.BASE_URL);
---

<header class="sticky top-0 z-30 border-b border-border bg-background">
  <div class="mx-auto flex items-center justify-between gap-3 h-[72px] px-4 lg:px-6">
    <div class="flex items-center gap-3 min-w-0">
      <slot name="brand">
        {/* The mark alone, back to the product's site. */}
        <a href="https://oxabl.org" class="flex shrink-0 items-baseline text-foreground no-underline">
          <Logo />
          <span class="sr-only">oxabl.org</span>
        </a>
      </slot>

      {showSections && (
        <nav aria-label="Sections" class="hidden md:flex items-center gap-1 ms-4 ps-4 border-s border-border h-6 min-w-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {sections.map((section) => (
            <a
              href={resolveSectionHref(section.href)}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "chrome px-2 py-1 no-underline shrink-0 whitespace-nowrap",
                section.isActive
                  ? "text-foreground underline underline-offset-[6px] decoration-[var(--rule-strong)]"
                  : "text-muted-foreground hover:text-foreground",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="actions" />
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <a href={config.github} target="_blank" rel="noopener" class="chrome px-2 py-1 text-muted-foreground no-underline hover:text-foreground">github</a>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
  {/* Phones: the tabs on a row of their own under the bar. */}
  {showSections && (
    <nav aria-label="Sections" data-nb-header-tabs class="md:hidden flex items-center gap-1 h-10 px-4 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {sections.map((section) => (
        <a
          href={resolveSectionHref(section.href)}
          aria-current={section.isActive ? "page" : undefined}
          class:list={[
            "chrome px-2 py-1 no-underline shrink-0 whitespace-nowrap",
            section.isActive
              ? "text-foreground underline underline-offset-[6px] decoration-[var(--rule-strong)]"
              : "text-muted-foreground hover:text-foreground",
          ]}
        >
          {section.label}
        </a>
      ))}
    </nav>
  )}
</header>
